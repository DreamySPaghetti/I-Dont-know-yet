<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Downloads the Standard card list (names + rarity) from Scryfall. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Floating "Scan" button drawn over Arena. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Screen capture runs in a foreground service, as Android requires. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="Arena Scanner"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CoachActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- Lets Gemma run on the GPU (LiteRT-LM); optional so phones without them still install. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <service
            android:name=".AutoScroll"
            android:exported="true"
            android:label="Arena Scanner auto-scroll"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/autoscroll" />
        </service>
        <service
            android:name=".ScanService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
